{
  "name": "@symbo.ls/mcp",
  "version": "3.14.161",
  "description": "Symbols.app MCP — docs, code generation, publishing, CLI/SDK reference",
  "mcpName": "io.github.symbo-ls/symbols-mcp",
  "files": [
    "dist",
    "*.md",
    "LICENSE",
    "bin/",
    "lib/",
    "symbols_mcp/skills/",
    "templates/agent-rules/"
  ],
  "bin": {
    "symbols-mcp": "./bin/symbols-mcp.js",
    "symbols-audit": "./bin/symbols-audit",
    "symbols-mcp-init-rules": "./bin/symbols-mcp-init-rules"
  },
  "exports": {
    "./package.json": "./package.json",
    "./lib/audit": {
      "development": "./lib/audit.js",
      "import": "./dist/esm/lib/audit.js",
      "require": "./dist/cjs/lib/audit.cjs",
      "default": "./dist/esm/lib/audit.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/symbo-ls/symbols-mcp.git"
  },
  "keywords": [
    "mcp",
    "symbols",
    "domql",
    "ai",
    "claude"
  ],
  "license": "CC-BY-NC-4.0",
  "publishConfig": {
    "access": "restricted"
  },
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "scripts": {
    "build:esm": "esbuild $(find . -type f -name \"*.js\" -not -path \"*/dist/*\" -not -path \"*/node_modules/*\" -not -path \"*/__tests__/*\" -not -path \"*/test/*\" -not -path \"*/demo/*\" -not -path \"*/demos/*\" -not -path \"*/examples/*\" -not -path \"*/fixtures/*\" -not -name \"*.test.js\") --target=es2022 --format=esm --outbase=. --outdir=dist/esm --minify --log-level=warning",
    "build:cjs": "esbuild $(find . -type f -name \"*.js\" -not -path \"*/dist/*\" -not -path \"*/node_modules/*\" -not -path \"*/__tests__/*\" -not -path \"*/test/*\" -not -path \"*/demo/*\" -not -path \"*/demos/*\" -not -path \"*/examples/*\" -not -path \"*/fixtures/*\" -not -name \"*.test.js\") --target=node20 --format=cjs --outbase=. --outdir=dist/cjs --out-extension:.js=.cjs --minify --log-level=warning",
    "build": "rimraf dist && npm run build:esm && npm run build:cjs",
    "prepublishOnly": "npm run build"
  },
  "type": "module"
}
